        <mxCell id="vNIofAzsAitLIyS9vQL7-43" parent="1" style="text;html=1;align=left;verticalAlign=top;fontFamily=Consolas, monospace;fontSize=10.5;spacingLeft=8;spacingTop=4;fontColor=light-dark(#000000,#f8fafc);" value="&lt;div style=&quot;line-height: 1.45;&quot;&gt;&lt;span style=&quot;color: #c084fc; font-weight: bold;&quot;&gt;@sim_output&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #fb7185; font-weight: bold;&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: #38bdf8;&quot;&gt;probe&lt;/span&gt;():&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #94a3b8;&quot;&gt;# Tagged debug probe&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #fb7185; font-weight: bold;&quot;&gt;if&lt;/span&gt; dut.valid:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #38bdf8;&quot;&gt;sim_print&lt;/span&gt;(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #fde047;&quot;&gt;f&quot;DATA={dut.out}&quot;&lt;/span&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #4ade80; font-weight: bold;&quot;&gt;debug=True&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;)&lt;/div&gt;" vertex="1">
